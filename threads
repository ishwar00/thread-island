#!/usr/bin/env python3
"""threads: Codex + Claude Code threads, recency-sorted, as JSON for the ThreadIsland notch app.

Sources: Codex desktop/CLI (~/.codex/state_*.sqlite), Claude desktop Code tab
(claude-code-sessions/*.json), Claude CLI background jobs (~/.claude/jobs) and
live interactive Claude CLI sessions (~/.claude/sessions).
Jumps: codex:// and claude:// deep links, Ghostty AppleScript (focus tab by tty,
or open a new window running the resume command). `--jump` reads one row's JSON on stdin.
"""
import datetime
import glob
import json
import os
import re
import sqlite3
import subprocess
import sys
import time

HOME = os.path.expanduser('~')
WINDOW_DAYS = 7
NOW = time.time()
TODAY = datetime.date.today()
# Same window as Codex's activity view: today plus the previous 6 local days
CUTOFF = time.mktime((TODAY - datetime.timedelta(days=WINDOW_DAYS - 1)).timetuple())
ACTIVE = {'needs you', 'failed', 'working'}
# A thread stays in Priority until the agent has been idle this long
IDLE_OUT = 2 * 3600

def run(cmd, stdin=None):
    try:
        return subprocess.run(cmd, input=stdin, capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ''


def ago(ts):
    s = max(0, NOW - ts)
    for unit, n in (('d', 86400), ('h', 3600), ('m', 60)):
        if s >= n:
            return f'{int(s // n)}{unit}'
    return 'now'


def ghostty_ttys():
    if not run(['pgrep', '-x', 'ghostty']):
        return set()
    out = run(['osascript', '-e', 'tell application "Ghostty" to get tty of every terminal'])
    return {t.strip() for t in out.split(',') if t.strip()}


def focus_target(p, gtty, by_pid):
    """(action, arg) that focuses the terminal a live session runs in: its Ghostty terminal by TTY, else its
    Warp tab via the WARP_FOCUS_URL Warp exports to every session (warpdotdev/warp PR #11130), else None."""
    if p['tty'] in gtty:
        return 'focus', p['tty']
    # The URL is inherited by everything a Warp tab starts, including Claude's background-job daemon and its
    # workers (which get their own TTYs), so trust it only when Warp itself is an ancestor of the session.
    a, hops = p, 0
    while a and 'Warp.app/' not in a['args'] and hops < 30:
        a, hops = by_pid.get(a['ppid']), hops + 1
    if a and 'Warp.app/' in a['args']:
        for tok in run(['ps', 'eww', '-o', 'command=', '-p', str(p['pid'])]).split():
            if tok.startswith('WARP_FOCUS_URL=warp://session/'):
                return 'url', tok.split('=', 1)[1]
    return None


def processes():
    rows = []
    for line in run(['ps', '-axo', 'pid=,ppid=,tty=,args=']).splitlines():
        parts = line.split(None, 3)
        if len(parts) == 4:
            rows.append({'pid': int(parts[0]), 'ppid': int(parts[1]), 'tty': '/dev/' + parts[2], 'args': parts[3]})
    return rows


def row(key, ts, src, state, title, detail, action, arg, cwd=''):
    # key is stable across refreshes (thread/job/session id); ts is your last message (the sort time);
    # each source then sets 'active' (the agent's last activity) and 'created' (Priority's sort time)
    return {'key': key, 'ts': ts, 'src': src, 'state': state, 'title': title, 'detail': detail,
            'action': action, 'arg': arg, 'cwd': cwd}


def plain(md):
    """One-line Markdown as plain text: [label](url) -> label, drop ** and backticks."""
    return re.sub(r'\[([^\]]+)\]\([^)]*\)', r'\1', md).replace('**', '').replace('`', '')


def codex_turn(rollout):
    """(state, last reply) from the end of a Codex rollout: a turn that started and is still being
    written is working; its last task_complete carries the reply shown in Codex's sidebar."""
    try:
        size = os.path.getsize(rollout)
        with open(rollout, 'rb') as fh:
            fh.seek(max(0, size - 512 * 1024))
            tail = fh.read().decode('utf-8', 'ignore').splitlines()
    except OSError:
        return '', None
    for text in reversed(tail):
        if '"task_' not in text and '"turn_aborted"' not in text:
            continue
        try:
            payload = json.loads(text).get('payload') or {}
        except ValueError:
            continue
        kind = payload.get('type')
        if kind == 'task_started':
            # Codex writes nothing while a turn waits on approval or hangs, so only a fresh write counts as working
            return ('working' if NOW - os.path.getmtime(rollout) < 600 else ''), None
        if kind == 'task_complete':
            return '', plain((payload.get('last_agent_message') or '').strip().split('\n')[0]) or None
        if kind == 'turn_aborted':
            return '', None
    return '', None


def codex_rows(procs, gtty):
    dbs = sorted(glob.glob(f'{HOME}/.codex/state_*.sqlite'),
                 key=lambda p: int(re.search(r'state_(\d+)', p).group(1)))
    if not dbs:
        return []
    query = """select id, coalesce(name, title), cwd, source, recency_at_ms, updated_at_ms, created_at_ms, rollout_path from threads
               where archived = 0 and coalesce(thread_source, 'user') = 'user'
                 and source in ('vscode', 'cli') and recency_at_ms >= ?"""
    # not mode=ro: a read-only open fails whenever Codex has just checkpointed the WAL to 0 bytes.
    # A normal connection joins WAL locking like any reader; query_only forbids writes from here.
    con = sqlite3.connect(dbs[-1], timeout=2)
    try:
        con.execute('pragma query_only = 1')
        found = con.execute(query, (CUTOFF * 1000,)).fetchall()
    finally:
        con.close()

    # live Codex CLI in a terminal: match the rollout file it holds open
    live, by_pid = {}, {p['pid']: p for p in procs}
    for p in procs:
        if p['tty'] != '/dev/??' and re.search(r'(^|/)codex(\s|$)', p['args']):
            target = None
            for name in run(['lsof', '-p', str(p['pid']), '-Fn']).splitlines():
                if name.startswith('n') and 'rollout-' in name:
                    live[name[1:]] = target = target or focus_target(p, gtty, by_pid)

    rows = []
    for tid, title, cwd, source, rec_ms, upd_ms, created_ms, rollout in found:
        src = 'codex' if source == 'vscode' else 'codex-cli'
        state, reply = codex_turn(rollout)
        detail = reply or os.path.basename(cwd)
        if live.get(rollout):
            rows.append(row(tid, rec_ms / 1000, src, state, title, detail, *live[rollout]))
        elif source == 'vscode':
            rows.append(row(tid, rec_ms / 1000, src, state, title, detail, 'url', f'codex://threads/{tid}'))
        else:
            rows.append(row(tid, rec_ms / 1000, src, state, title, detail, 'tab', f'codex resume {tid}', cwd))
        rows[-1].update(active=(upd_ms or rec_ms) / 1000, created=(created_ms or rec_ms) / 1000, log=('codex', rollout))
    return rows


def claude_desktop_rows():
    rows = []
    pattern = f'{HOME}/Library/Application Support/Claude/claude-code-sessions/*/*/local_*.json'
    for f in glob.glob(pattern):
        if os.path.getmtime(f) < CUTOFF:  # files are large; mtime >= lastActivityAt, so skip unparsed
            continue
        try:
            d = json.load(open(f))
        except (OSError, ValueError):
            continue
        # your last message, like Codex's recency_at; lastActivityAt moves with every agent step
        ts = (d.get('latestUserFrameAt') or d.get('lastActivityAt') or 0) / 1000
        if d.get('isArchived') or ts < CUTOFF:
            continue
        summary = d.get('postTurnSummary') or {}
        state = 'needs you' if summary.get('status_category') == 'blocked' else ''
        rows.append(row(d['sessionId'], ts, 'claude-app', state, d.get('title') or '(untitled)',
                        summary.get('status_detail') or d.get('cwd', ''),
                        'url', f"claude://code/continue?session={d['sessionId']}"))
        rows[-1].update(active=(d.get('lastActivityAt') or 0) / 1000, created=(d.get('createdAt') or 0) / 1000,
                        log=('claude', transcript_path(d.get('cliSessionId'))))
    return rows


def records(buf, marker):
    """JSON lines in buf that contain marker, newest first. Searches the raw bytes backwards, so only
    matching lines are decoded (decoding and splitting whole tails peaked at 150 MB)."""
    end = len(buf)
    while (i := buf.rfind(marker, 0, end)) != -1:
        start = buf.rfind(b'\n', 0, i) + 1
        stop = buf.find(b'\n', i)
        try:
            yield json.loads(buf[start:stop if stop != -1 else len(buf)])
        except ValueError:  # the tail's first line may be cut off
            pass
        end = start


def last_record(buf, marker, rtype):
    return next((r for r in records(buf, marker) if r.get('type') == rtype), None)


def transcript_path(session_id):
    paths = glob.glob(f'{HOME}/.claude/projects/*/{session_id}.jsonl') if session_id else []
    return paths[0] if paths else None


# Where each source records a turn: Claude marks the messages you type, Codex logs every turn start
TURNS = {
    'claude': (b'"origin":{"kind":"human"}', lambda r: r.get('type') == 'user'),
    'codex': (b'"type":"task_started"', lambda r: (r.get('payload') or {}).get('type') == 'task_started'),
}


def streak_start(kind, path):
    """When the thread's current run of activity began: its first turn after a gap of IDLE_OUT or more,
    else its first turn. Reads the log backwards in 4 MB chunks only until that gap, so memory stays at
    one chunk however long the log is."""
    marker, is_turn = TURNS[kind]
    chunk, start, carry = 4 * 1024 * 1024, None, b''
    try:
        with open(path, 'rb') as fh:
            pos = os.path.getsize(path)
            while pos > 0:
                n = min(chunk, pos)
                pos -= n
                fh.seek(pos)
                buf = fh.read(n) + carry
                # the first line may continue in the previous chunk: keep it for the next round
                cut = buf.find(b'\n') if pos > 0 else -1
                carry, buf = (buf[:cut + 1], buf[cut + 1:]) if cut != -1 else (b'', buf)
                for rec in records(buf, marker):
                    if not is_turn(rec) or not rec.get('timestamp'):
                        continue
                    t = epoch(rec['timestamp'])
                    if start is not None and start - t >= IDLE_OUT:
                        return start
                    start = t
    except (OSError, ValueError):
        pass
    return start


def transcript_info(session_id):
    """(title, time of your last message) from the end of a Claude transcript. The title is the latest
    rename, else the latest AI title. Rows sort on your last message, like Codex's recency_at, so agent
    activity doesn't reshuffle the list."""
    path = transcript_path(session_id)
    if not path:
        return None, None
    size = os.path.getsize(path)
    custom = ai = sent = None
    # ponytail: tail reads (transcripts reach 100+ MB); an agent that wrote more than 8 MB since your
    # last message falls back to activity time
    for span in (512 * 1024, 8 * 1024 * 1024):
        with open(path, 'rb') as fh:
            fh.seek(max(0, size - span))
            tail = fh.read()
        custom = custom or last_record(tail, b'"type":"custom-title"', 'custom-title')
        ai = ai or last_record(tail, b'"type":"ai-title"', 'ai-title')
        human = last_record(tail, b'"origin":{"kind":"human"}', 'user')
        sent = human.get('timestamp') if human else None
        if sent or span >= size:
            break
    return (custom or {}).get('customTitle') or (ai or {}).get('aiTitle'), epoch(sent) if sent else None


def epoch(iso):
    return datetime.datetime.fromisoformat(iso.replace('Z', '+00:00')).timestamp()


def claude_cli_rows(procs, gtty):
    proc = {p['pid']: p for p in procs}
    attached = {}  # job name/id -> where its `claude attach` runs
    for p in procs:
        m = re.search(r'\bclaude\b.*\battach\s+(\S+)', p['args'])
        if m and p['tty'] != '/dev/??':
            target = focus_target(p, gtty, proc)
            if target:
                attached[m.group(1)] = target

    live, busy_jobs = [], set()
    for f in glob.glob(f'{HOME}/.claude/sessions/*.json'):
        try:
            d = json.load(open(f))
            os.kill(d['pid'], 0)
        except (OSError, ValueError, KeyError):
            continue
        if d.get('kind') == 'interactive':
            live.append(d)
        elif d.get('jobId') and d.get('status') == 'busy':
            busy_jobs.add(d['jobId'])
    # A window in agent view parks its own session as a job; an unnamed parked job is that empty window, not a thread
    parked = {d['parkedJobId'] for d in live if d.get('parkedJobId')}

    rows, seen = [], set()
    for f in glob.glob(f'{HOME}/.claude/jobs/*/state.json'):
        jid = os.path.basename(os.path.dirname(f))
        try:
            d = json.load(open(f))
        except (OSError, ValueError):
            continue
        if jid in parked and not d.get('name'):
            continue
        if os.path.getmtime(f) < CUTOFF:
            continue
        ts = transcript_info(d.get('sessionId'))[1] or os.path.getmtime(f)
        seen.add(d.get('sessionId'))
        # state.json lags a reply (stays 'blocked' until the next summary); a busy live session wins, as in `claude agents`
        state = 'working' if jid in busy_jobs else {'blocked': 'needs you'}.get(d.get('state'), d.get('state') or '')
        title = d.get('name') or d.get('displayIntent') or d.get('intent') or jid
        target = next((attached[k] for k in (jid, d.get('name'), d.get('sessionId')) if k in attached), None)
        if target:
            rows.append(row(jid, ts, 'claude-bg', state, title, d.get('detail') or '', *target))
        else:
            rows.append(row(jid, ts, 'claude-bg', state, title, d.get('detail') or '', 'tab',
                            f'claude attach {jid}', d.get('cwd') or HOME))
        created = d.get('createdAt')
        rows[-1].update(active=os.path.getmtime(f), created=epoch(created) if created else os.path.getmtime(f),
                        log=('claude', transcript_path(d.get('sessionId'))))

    for d in live:
        # agent-view windows aren't threads; the jobs they show are listed above
        if d.get('sessionId') in seen or d.get('parkedJobId'):
            continue
        t_title, sent = transcript_info(d['sessionId'])
        ts = sent or (d.get('updatedAt') or d.get('startedAt') or 0) / 1000
        state = 'working' if d.get('status') == 'busy' else ''
        title = d.get('name') if d.get('nameSource') == 'user' else None
        title = title or t_title or d.get('name') or d['sessionId']
        target = focus_target(proc[d['pid']], gtty, proc) if d['pid'] in proc else None
        # other terminals (Terminal.app, iTerm2, ...) aren't supported yet: the row shows but doesn't jump
        rows.append(row(d['sessionId'], ts, 'claude-cli', state, title, d.get('cwd', ''), *(target or ('none', ''))))
        rows[-1].update(active=(d.get('updatedAt') or d.get('startedAt') or 0) / 1000,
                        created=(d.get('startedAt') or 0) / 1000, log=('claude', transcript_path(d['sessionId'])))
    return rows


GHOSTTY_FOCUS = '''on run argv
    tell application "Ghostty"
        focus (first terminal whose tty is (item 1 of argv))
        activate
    end tell
end run'''

GHOSTTY_TAB = '''on run argv
    tell application "Ghostty"
        set cfg to new surface configuration
        set initial working directory of cfg to (item 1 of argv)
        set initial input of cfg to (item 2 of argv) & linefeed
        new window with configuration cfg
        activate
    end tell
end run'''


def new_session_terminal():
    """Terminal for a session that isn't open anywhere: the one you were just in (the island never takes
    focus), else whichever is running (Ghostty first), else Ghostty."""
    front = run(['lsappinfo', 'info', '-only', 'name', run(['lsappinfo', 'front']).strip()])
    for app in ('Warp', 'Ghostty'):
        if f'"{app}"' in front:
            return app
    if run(['pgrep', '-x', 'ghostty']):
        return 'Ghostty'
    return 'Warp' if run(['pgrep', '-f', '/Applications/Warp.app/Contents/MacOS/stable$']) else 'Ghostty'


def warp_open(cwd, command):
    """Open a Warp tab in cwd running command. The URI scheme can't run commands; a Tab Config can, and Warp
    re-reads the file on every open (https://docs.warp.dev/terminal/sessions/tab-configs). A new window
    would also get an empty default tab, so this opens a tab in the front Warp window."""
    with open(f'{HOME}/.warp/tab_configs/threadisland.toml', 'w') as fh:
        fh.write('name = "ThreadIsland"\n\n[[panes]]\nid = "main"\ntype = "terminal"\n'
                 f'directory = {json.dumps(cwd)}\ncommands = [{json.dumps(command)}]\n')
    subprocess.run(['open', 'warp://tab_config/threadisland'])


def jump(r):
    if r['action'] == 'url':
        subprocess.run(['open', r['arg']])
    elif r['action'] == 'focus':
        subprocess.run(['osascript', '-', r['arg']], input=GHOSTTY_FOCUS, text=True)
    elif r['action'] == 'tab':
        if new_session_terminal() == 'Warp':
            warp_open(r['cwd'] or HOME, r['arg'])
        else:
            subprocess.run(['osascript', '-', r['cwd'] or HOME, r['arg']], input=GHOSTTY_TAB, text=True)


def sectioned(rows):
    """Positions are learned, so rows never swap, and nothing needs remembering between runs:
    Priority holds threads that are active or were active in the last 2 h, in the order their current run
    of activity began, so a thread that becomes active (new or not) joins at the bottom. Day sections sort
    by your last message, which can't change there: a new message makes a thread active, and it moves to
    Priority."""
    def hot(r):
        return r['state'] in ACTIVE or NOW - r.get('active', 0) < IDLE_OUT
    for r in rows:
        kind, path = r.pop('log', (None, None))
        if path and hot(r):
            r['entered'] = streak_start(kind, path)
    priority = sorted((r for r in rows if hot(r)),
                      key=lambda r: r.get('entered') or r.get('created') or r['ts'])
    # the 7-day window applies to sort time (your last message), which can be older than a source's file mtime
    recent = sorted((r for r in rows if not hot(r) and r['ts'] >= CUTOFF), key=lambda r: -r['ts'])
    for r in priority:
        r['section'] = 'Priority'
    for r in recent:
        day = datetime.date.fromtimestamp(r['ts'])
        r['section'] = ('Today' if day == TODAY else 'Yesterday' if (TODAY - day).days == 1
                        else day.strftime('%A'))
    return priority + recent


def main():
    if '--jump' in sys.argv:
        jump(json.load(sys.stdin))
        return

    procs = processes()
    gtty = ghostty_ttys()
    rows, errors = [], []
    # each source reads private files that an app update can change; report a broken one instead of hiding it
    for name, source in (('Codex', lambda: codex_rows(procs, gtty)), ('Claude app', claude_desktop_rows),
                         ('Claude CLI', lambda: claude_cli_rows(procs, gtty))):
        try:
            rows += source()
        except Exception as e:  # noqa: BLE001 - any failure here is shown in the panel
            errors.append(f'{name}: {type(e).__name__}: {e}')
    rows = sectioned(rows)

    for r in rows:
        r['age'] = ago(r['ts'])
    json.dump({'rows': rows, 'errors': errors}, sys.stdout)


if __name__ == '__main__':
    main()
